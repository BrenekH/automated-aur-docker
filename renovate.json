{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/Boise",
  "schedule": ["* * * * 1"], // Only run on Mondays by default
  "minimumReleaseAge": "7 days",
  "automergeType": "branch",
  "packageRules": {
    // General automatic updates
    {
      "matchUpdateTypes": ["patch", "pin", "digest"],
      // Exclude pre-1.0.0 versions
      "matchCurrentVersion": "!/^0/",
      "automerge": true,
      "schedule": ["* 2-10 * * *"] // Allow small updates any time between 2 and 10am
    },

    // Create an automerging PR for minor versions
    {
      "matchUpdateTypes": ["minor"],
      // Exclude pre-1.0.0 versions
      "matchCurrentVersion": "!/^0/",
      "automergeType": "pr",
      "automerge": true
    }
  }
}
